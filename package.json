{
  "name": "befirst-energy-solution",
  "version": "1.0.0",
  "description": "BEFIRST ENERGY SOLUTION - Solar Equipment Business Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win",
    "pack": "electron-builder --dir",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "author": "BEFIRST ENERGY",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "@tauri-apps/cli": "^2"
  },
  "dependencies": {
    "sql.js": "^1.10.3",
    "electron-log": "^5.0.1",
    "pdfkit": "^0.14.0"
  },
  "build": {
    "appId": "com.befirst.energy",
    "productName": "BEFIRST ENERGY SOLUTION",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}